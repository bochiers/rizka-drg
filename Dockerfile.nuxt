# Multi-stage build: Nuxt 4 SSG -> static nginx
FROM node:22-alpine AS build
WORKDIR /app/nuxt-app
COPY nuxt-app/package.json nuxt-app/package-lock.json ./
RUN npm ci
COPY nuxt-app/ ./
RUN npm run generate

FROM nginx:1.27-alpine
COPY --from=build /app/nuxt-app/.output/public /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
